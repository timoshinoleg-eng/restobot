# .env.example — RestoBot Configuration
# Copy to .env and fill in real values

# ─── Application ───────────────────────────────────────────────────
DEBUG=false
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_FORMAT=json

# ─── Database ────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://restobot:password@localhost:5432/restobot

# ─── Redis ──────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS_ENABLED=false

# ─── Telegram ──────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_WEBHOOK_URL=https://api.restobot.ru/webhook
TELEGRAM_WEBHOOK_SECRET=random_secret_string

# ─── Yandex Cloud ─────────────────────────────────────────────
YC_FOLDER_ID=b1gxxxxxxxxxxxxxxxx
YC_IAM_TOKEN=  # Leave empty to use metadata service inside YC VM

# ─── Payments (ЮKassa) ─────────────────────────────────────────
YOOKASSA_SHOP_ID=your_shop_id
YOOKASSA_SECRET_KEY=your_secret_key
YOOKASSA_RETURN_URL=https://t.me/your_bot

# ─── Security ──────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_min_32_chars

# ─── Object Storage ───────────────────────────────────────────
YC_OBJECT_STORAGE_BUCKET=restobot-media
YC_OBJECT_STORAGE_ENDPOINT=https://storage.yandexcloud.net
