# ─── Images ─────────────────────────────────────────────────────────
# Примеры тегов: cr.yandex/<registry-id>/restobot-admin:v1.0.0
ADMIN_IMAGE=cr.yandex/<registry>/restobot-admin:latest
PUBLIC_IMAGE=cr.yandex/<registry>/restobot-public:latest

# ─── Database ───────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://user:pass@<managed-pg-host>:5432/restobot

# ─── Redis (component-based; avoids URL-parsing bugs with special chars in password)
REDIS_HOST=<managed-redis-host>
REDIS_PORT=6379
# Обязательно для managed Redis YC (пароль со спецсимволами)
REDIS_PASSWORD=<redis-password>
REDIS_DB=0
# Для YC Managed Redis TLS обязателен (rediss://)
REDIS_TLS_ENABLED=true

# ─── Secrets / Runtime ──────────────────────────────────────────────
JWT_SECRET=change_me_min_32_chars
YC_FOLDER_ID=b1g...

# Оставить пустым для использования metadata service внутри YC VM
YC_IAM_TOKEN=

YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
TELEGRAM_BOT_TOKEN=

YC_OBJECT_STORAGE_BUCKET=restobot-media
YC_OBJECT_STORAGE_ENDPOINT=https://storage.yandexcloud.net

ENABLE_BOOTSTRAP_API=false
# Задать при временном включении bootstrap API (onboarding)
BOOTSTRAP_API_TOKEN=
